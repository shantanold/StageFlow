generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  staff
  manager
}

enum ItemStatus {
  available
  staged
  disposed
  missing
}

enum ItemCondition {
  good
  fair
  damaged
}

enum JobStatus {
  planning
  active
  completed
  cancelled
}

enum JobItemStatus {
  assigned
  loaded
  delivered
  picked_up
  returned
  missing
}

enum ReturnCondition {
  good
  damaged
  dispose
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  invite_code String   @unique
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  users      User[]
  items      Item[]
  sets       Set[]
  jobs       Job[]
  job_items  JobItem[]
  movements  Movement[]

  @@map("organizations")
}

model User {
  id            String   @id @default(uuid())
  org_id        String
  name          String
  email         String   @unique
  password_hash String
  role          Role     @default(staff)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  org           Organization @relation(fields: [org_id], references: [id])
  jobs_created  Job[]       @relation("JobCreatedBy")
  movements     Movement[]  @relation("MovementPerformedBy")

  @@index([org_id])
  @@map("users")
}

model Set {
  id          String   @id @default(uuid())
  org_id      String
  name        String
  description String   @default("")
  created_at  DateTime @default(now())

  org         Organization @relation(fields: [org_id], references: [id])
  items       Item[]

  @@index([org_id])
  @@map("sets")
}

model Item {
  id            String        @id @default(uuid())
  org_id        String
  sku           String
  name          String
  category      String
  set_id        String?
  status        ItemStatus    @default(available)
  condition     ItemCondition @default(good)
  photo_url     String?
  purchase_cost Decimal       @db.Decimal(10, 2)
  purchase_date DateTime?     @db.Date
  width_in      Decimal?      @db.Decimal(6, 1)
  depth_in      Decimal?      @db.Decimal(6, 1)
  height_in     Decimal?      @db.Decimal(6, 1)
  notes         String?
  qr_printed    Boolean       @default(false)
  /// True for pre-printed blank QR stickers awaiting real furniture details.
  is_unlabeled  Boolean       @default(false)
  created_at    DateTime      @default(now())

  org           Organization  @relation(fields: [org_id], references: [id])
  set           Set?          @relation(fields: [set_id], references: [id])
  job_items     JobItem[]
  movements     Movement[]

  @@unique([org_id, sku])
  @@index([org_id, status])
  @@index([org_id, is_unlabeled])
  @@map("items")
}

model Job {
  id                String    @id @default(uuid())
  org_id            String
  address           String
  city              String
  state             String
  zip               String
  client_name       String
  client_contact    String
  status            JobStatus @default(planning)
  start_date        DateTime  @db.Date
  expected_end_date DateTime  @db.Date
  actual_end_date   DateTime? @db.Date
  created_by        String
  notes             String?
  created_at        DateTime  @default(now())

  org               Organization @relation(fields: [org_id], references: [id])
  creator           User      @relation("JobCreatedBy", fields: [created_by], references: [id])
  job_items         JobItem[]
  movements         Movement[]

  @@index([org_id, status])
  @@map("jobs")
}

model JobItem {
  id               String          @id @default(uuid())
  org_id           String
  job_id           String
  item_id          String
  status           JobItemStatus   @default(assigned)
  return_condition ReturnCondition?
  return_notes     String?
  assigned_at      DateTime        @default(now())
  returned_at      DateTime?

  org              Organization    @relation(fields: [org_id], references: [id])
  job              Job             @relation(fields: [job_id], references: [id])
  item             Item            @relation(fields: [item_id], references: [id])

  @@index([org_id])
  @@map("job_items")
}

model Movement {
  id           String   @id @default(uuid())
  org_id       String
  item_id      String
  job_id       String?
  from_status  String
  to_status    String
  performed_by String
  notes        String?
  created_at   DateTime @default(now())

  org          Organization @relation(fields: [org_id], references: [id])
  item         Item     @relation(fields: [item_id], references: [id])
  job          Job?     @relation(fields: [job_id], references: [id])
  performer    User     @relation("MovementPerformedBy", fields: [performed_by], references: [id])

  @@index([org_id])
  @@map("movements")
}
